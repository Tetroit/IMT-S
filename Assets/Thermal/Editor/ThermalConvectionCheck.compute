// Thermal > Convection Check's kernels (item 6, wind): ThermalPhysics.hlsl's own functions, run on the GPU on
// cases with known answers. The cases and the answers are in ThermalConvectionCheck.cs.
//
// Until ThermalPhysics.hlsl defines THERMAL_PHYSICS_CONVECTION, the kernels compile to nothing and the check
// reports the physics as not written yet, so the console stays clean while it is being written. Once it is
// defined, they need: ThermalEnvironment.windSpeed, ThermalSurface.windA and .windB, and
// float ConvectiveCoefficient(float windA, float windB, float windSpeed, float dT).

#pragma kernel Echo
#pragma kernel Ready
#pragma kernel Coefficient
#pragma kernel Balance

#include "../ThermalPhysics.hlsl"

RWStructuredBuffer<float> _Ready;
uint _Count;

struct CoefficientCase
{
    float windA, windB, windSpeed, dT;
};
StructuredBuffer<CoefficientCase> _CoefficientCases;
RWStructuredBuffer<float> _CoefficientOut;

// Floats only, so the layout is the same on every graphics API: a float3 member would be padded under some.
struct BalanceCase
{
    float nx, ny, nz, alpha, eps, skyView, sunVis, skyDiffuseBroadband, windA, windB;
    float airT, windSpeed, dni, dhi, ghi, albedo, sx, sy, sz;
};
StructuredBuffer<BalanceCase> _BalanceCases;
RWStructuredBuffer<float2> _BalanceOut;     // the surface temperature, and h at it

// The check's own plumbing, independent of the physics: every case read back field by field, by name, so a
// layout that differs between C# and HLSL shows here and not as a wrong temperature. Coefficient cases first.
RWStructuredBuffer<float> _Echo;
uint _CoefficientCount;

[numthreads(64, 1, 1)]
void Echo(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CoefficientCount)
    {
        CoefficientCase c = _CoefficientCases[id.x];
        uint o = id.x * 4;
        _Echo[o + 0] = c.windA;
        _Echo[o + 1] = c.windB;
        _Echo[o + 2] = c.windSpeed;
        _Echo[o + 3] = c.dT;
    }
    if (id.x < _Count)
    {
        BalanceCase c = _BalanceCases[id.x];
        uint o = _CoefficientCount * 4 + id.x * 19;
        _Echo[o + 0] = c.nx;
        _Echo[o + 1] = c.ny;
        _Echo[o + 2] = c.nz;
        _Echo[o + 3] = c.alpha;
        _Echo[o + 4] = c.eps;
        _Echo[o + 5] = c.skyView;
        _Echo[o + 6] = c.sunVis;
        _Echo[o + 7] = c.skyDiffuseBroadband;
        _Echo[o + 8] = c.windA;
        _Echo[o + 9] = c.windB;
        _Echo[o + 10] = c.airT;
        _Echo[o + 11] = c.windSpeed;
        _Echo[o + 12] = c.dni;
        _Echo[o + 13] = c.dhi;
        _Echo[o + 14] = c.ghi;
        _Echo[o + 15] = c.albedo;
        _Echo[o + 16] = c.sx;
        _Echo[o + 17] = c.sy;
        _Echo[o + 18] = c.sz;
    }
}

[numthreads(1, 1, 1)]
void Ready(uint3 id : SV_DispatchThreadID)
{
#if defined(THERMAL_PHYSICS_CONVECTION)
    _Ready[0] = 1;
#else
    _Ready[0] = 0;
#endif
}

[numthreads(64, 1, 1)]
void Coefficient(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count)
        return;
#if defined(THERMAL_PHYSICS_CONVECTION)
    CoefficientCase c = _CoefficientCases[id.x];
    _CoefficientOut[id.x] = ConvectiveCoefficient(c.windA, c.windB, c.windSpeed, c.dT);
#else
    _CoefficientOut[id.x] = 0;
#endif
}

[numthreads(64, 1, 1)]
void Balance(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count)
        return;
#if defined(THERMAL_PHYSICS_CONVECTION)
    BalanceCase c = _BalanceCases[id.x];

    // Zeroed first: a field added later that the check does not know reads 0, not garbage.
    ThermalSurface s = (ThermalSurface)0;
    s.emissivity          = c.eps;
    s.solarAbsorptivity   = c.alpha;
    s.skyViewFactor       = c.skyView;
    s.sunVisibility       = c.sunVis;
    s.skyDiffuseBroadband = c.skyDiffuseBroadband;
    s.windA               = c.windA;
    s.windB               = c.windB;

    ThermalEnvironment e = (ThermalEnvironment)0;
    e.airTemperature    = c.airT;
    e.windSpeed         = c.windSpeed;
    e.directNormal      = c.dni;
    e.diffuseHorizontal = c.dhi;
    e.globalHorizontal  = c.ghi;
    e.groundAlbedo      = c.albedo;
    e.sunDirection      = float3(c.sx, c.sy, c.sz);

    EnergyBalance b = MakeBalance(float3(c.nx, c.ny, c.nz), s, e);
    float t = SurfaceTemperature(b);
    _BalanceOut[id.x] = float2(t, ConvectiveCoefficient(c.windA, c.windB, c.windSpeed, t - c.airT));
#else
    _BalanceOut[id.x] = 0;
#endif
}
